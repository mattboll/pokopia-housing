  "firstVisit": {
    "title": "First visit?",
    "optimal": "Each card is a house. The red counter says how many items to craft. Tap a house to see which ones, and why these Pokemon go together.",
    "village": "Add your Pokemon, we group them four per house. Tap a house for its shopping list, lock the ones you already built.",
    "close": "Got it"
  },
  "help": {
    "title": "How it works",
    "rulesTitle": "The game rules",
    "rules": "A house holds up to 4 Pokemon of the same environment (Bright, Dark, Warm, Cool, Humid, Dry). Each Pokemon has 6 favorites: 5 item categories and 1 flavor. An item placed in the house counts for every resident who likes it, and one item often carries several categories: a round wooden table pleases fans of wood and of round things.",
    "goalTitle": "What the tool optimizes",
    "goal": "Pokemon are grouped so that each house needs as few items as possible, assuming a Pokemon is happy with 4 of its 6 favorites (adjustable). Then real items covering several favorites at once are picked.",
    "starsTitle": "The stars",
    "starsText": "Five stars: the house needs about as many items as a single Pokemon would. One star: every resident needs its own items.",
    "dishTitle": "Dishes",
    "dishText": "Flavors (sweet, spicy, bitter, dry, sour) are not decorations: they are food to cook or gift to the Pokemon.",
    "dataTitle": "Where the data comes from",
    "dataText": "Pokemon favorites and item categories from Serebii, French item names from Pokekalos. The item catalog is still incomplete, corrections are welcome on GitHub.",
    "privacyTitle": "Your data",
    "privacyText": "Your village, selection and items stay in your browser. Nothing is sent anywhere. The share link carries everything needed to rebuild it elsewhere."
  },
